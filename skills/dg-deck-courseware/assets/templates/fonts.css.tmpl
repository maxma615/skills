/* subset WOFF2 (SIL OFL): Noto Sans CJK SC, Outfit, JetBrains Mono */
@font-face{font-family:"DG CJK";src:url(data:font/woff2;base64,{{FONT_CJK_400}}) format("woff2");font-weight:400;font-style:normal;font-display:block}
@font-face{font-family:"DG CJK";src:url(data:font/woff2;base64,{{FONT_CJK_700}}) format("woff2");font-weight:700;font-style:normal;font-display:block}
@font-face{font-family:"DG Sans";src:url(data:font/woff2;base64,{{FONT_SANS}}) format("woff2");font-weight:100 900;font-style:normal;font-display:block}
@font-face{font-family:"DG Mono";src:url(data:font/woff2;base64,{{FONT_MONO}}) format("woff2");font-weight:100 900;font-style:normal;font-display:block}
